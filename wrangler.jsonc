{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "martian-map",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "preview_urls": true,
  "previews": {},
  "workers_dev": true
}
